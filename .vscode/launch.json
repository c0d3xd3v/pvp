{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "pvp",
            "type": "debugpy",
            "request": "launch",
            "module": "pvp",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src",
                "PYTHONUNBUFFERED": "1"
            },
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "pvp: Datei öffnen …",
            "type": "debugpy",
            "request": "launch",
            "module": "pvp",
            "args": ["${input:startupFile}"],
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src",
                "PYTHONUNBUFFERED": "1"
            },
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "pvp: Smoke-Test",
            "type": "debugpy",
            "request": "launch",
            "module": "pvp",
            "args": ["--smoke-test"],
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src",
                "PYTHONUNBUFFERED": "1"
            },
            "console": "integratedTerminal"
        },
        {
            "name": "pytest",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["tests", "-q"],
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "console": "integratedTerminal",
            "justMyCode": false
        }
    ],
    "inputs": [
        {
            "id": "startupFile",
            "type": "promptString",
            "description": "Pfad zur Datei (STL, .vol, Projekt .h5 …)"
        }
    ]
}
